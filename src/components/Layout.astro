---
import PlausibleAnalytics from './PlausibleAnalytics.astro';
import Analytics  from '@vercel/analytics/astro';
import { site } from '@content/site';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { buildTitle, buildDescription, buildCanonicalUrl, buildOrganizationJsonLd } from '@utils/seo';

const { title, description, path = '/' } = Astro.props as {
  title?: string;
  description?: string;
  path?: string;
};

const fullTitle = buildTitle(title);
const metaDescription = description ?? buildDescription();
const origin = Astro.site?.toString() ?? 'https://excelstark.com';
const canonical = buildCanonicalUrl(origin, path);
const orgJsonLd = buildOrganizationJsonLd(origin);
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: site.faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark transition-colors duration-300" data-theme>
  <head>
    <meta charset="utf-8" />
    <title>{fullTitle}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Excel Stark" />
    <meta property="og:image" content="{origin}/hero-repair-inspection.png" />
    <meta property="og:image:alt" content="Engineer measuring composite wrap repair on pipeline" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="900" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content="{origin}/hero-repair-inspection.png" />

    <link rel="preload" as="image" href="/hero-repair-inspection.png" imagesrcset="/hero-repair-inspection.png" />
    <link rel="dns-prefetch" href="https://hcaptcha.com" />
    <link rel="dns-prefetch" href="https://js.hcaptcha.com" />

    <meta name="theme-color" content="#1E3A8A" />

    <script type="application/ld+json" is:inline>{JSON.stringify(orgJsonLd)}</script>
    <script type="application/ld+json" is:inline>{JSON.stringify(faqJsonLd)}</script>
    <!-- Theme initialization (runs early to avoid FOUC) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light') {
            document.documentElement.classList.remove('dark');
          } else if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            // Use system preference first
            const prefersLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
            if (prefersLight) {
              document.documentElement.classList.remove('dark');
              localStorage.setItem('theme', 'light');
            } else {
              document.documentElement.classList.add('dark');
              localStorage.setItem('theme', 'dark');
            }
          }
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- Vercel & Plausible analytics -->
    <PlausibleAnalytics />
    <Analytics />
  </head>
  <body class="bg-white text-slate-800 dark:bg-industrial-steel dark:text-slate-100 transition-colors duration-300">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-black text-white px-3 py-2 rounded"
    >
      Skip to main content
    </a>
    <Header nav={site.nav} aria-label="Primary" />
    <main id="main" class="min-h-screen" role="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
