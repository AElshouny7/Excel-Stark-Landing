---
import { site } from '@content/site';
import { buildFaqJsonLd } from '@utils/seo';

const origin = Astro.site?.toString() ?? 'https://excelstark.com';
const faqJsonLd = buildFaqJsonLd(origin, site.faqs);
---

<section id="faq" class="border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950 transition-colors duration-300">
  <div class="container py-16 grid gap-10 lg:grid-cols-[1.1fr_1.4fr]">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-industrial-orange">
        FAQ
      </p>
      <h2 class="mt-2 text-2xl font-semibold text-slate-800 dark:text-white">
        Leak severity, pressure range, certifications & response.
      </h2>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
        These questions come directly from plant managers, pipeline integrity engineers and
        offshore operators dealing with live leaks and integrity concerns.
      </p>
    </div>

    <div class="space-y-2" aria-label="Frequently asked questions">
      {site.faqs.map((faq, index) => (
        <details
          class="group rounded-2xl border border-slate-200 bg-slate-50 p-4 transition-colors duration-300 dark:border-slate-800 dark:bg-slate-900/70"
          {...(index === 0 ? { open: true } : {})}
          data-faq
        >
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-medium text-slate-800 dark:text-white">
            <span>{faq.question}</span>
            <span class="ml-auto text-xs text-slate-400 group-open:hidden">+</span>
            <span class="ml-auto text-xs text-slate-400 hidden group-open:inline">–</span>
          </summary>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </div>

  <script type="application/ld+json" is:inline>
    {JSON.stringify(faqJsonLd)}
  </script>
  <script is:inline>
    // Ensure only one FAQ detail stays open at a time
    const faqContainer = document.currentScript?.previousElementSibling?.previousElementSibling;
    const detailsList = document.querySelectorAll('section#faq [data-faq]');
    detailsList.forEach(d => {
      d.addEventListener('toggle', () => {
        if (d.open) {
          detailsList.forEach(other => {
            if (other !== d && other.open) other.open = false;
          });
        }
      });
    });
  </script>
</section>
