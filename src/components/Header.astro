---
import type { InferGetStaticPropsType } from "astro";
const { nav } = Astro.props as { nav: { href: string; label: string }[] };
---

<header class="border-b border-slate-800 bg-slate-950/80 backdrop-blur">
  <div class="container flex items-center justify-between py-4">
    <a href="/" class="flex items-center gap-3">
      <img src="/logo.png" alt="Excel Stark logo" class="h-16 w-18" />
      <span class="text-base font-semibold tracking-wide text-slate-200"
        >Online Leak Sealing</span
      >
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-slate-300 hover:text-white transition"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="inline-flex items-center rounded-full bg-industrial-orange px-4 py-2 text-xs font-semibold uppercase tracking-wide text-white shadow-card"
        data-analytics-event="nav_contact"
      >
        Request Support
      </a>
    </nav>
  </div>
</header>
