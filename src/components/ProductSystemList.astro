---
import { site } from "@content/site";
---

<section
  id="products"
  class="relative bg-slate-950 border-y border-slate-800 overflow-hidden"
>
  <picture
    class="absolute inset-0 h-full w-full opacity-20 pointer-events-none select-none"
  >
    <source srcset="/hero-shoreline-repair.avif" type="image/avif" />
    <source srcset="/hero-shoreline-repair.webp" type="image/webp" />
    <img
      src="/hero-shoreline-repair.png"
      width="1600"
      height="900"
      alt="Background image showing pipeline surface for product systems section"
      class="h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div class="relative container py-16 space-y-8">
    <header class="max-w-2xl">
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-industrial-orange"
      >
        Product Systems
      </p>
      <h2 class="mt-2 text-2xl font-semibold">
        Composite and leak sealing systems, engineered for live assets.
      </h2>
      <p class="mt-3 text-sm text-slate-300">
        Drawn from independently tested systems such as Iridium Wrap Carbon,
        Titanium Wrap Glass and HydroWrap – covering temperatures from -55°C to
        +550°C and pressures up to high transmission pipeline levels.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {
        site.productSystems.map((sys) => (
          <article class="flex flex-col gap-3 rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-base font-semibold text-white">{sys.name}</h3>
              <span class="rounded-full border border-industrial-orange/40 px-2 py-0.5 text-[10px] uppercase tracking-wide text-industrial-orange">
                {sys.type}
              </span>
            </div>
            <p class="text-sm text-slate-300">{sys.description}</p>
            <ul class="mt-1 space-y-1 text-sm text-slate-400">
              {sys.keyFeatures.map((f) => (
                <li>• {f}</li>
              ))}
            </ul>
            <p class="mt-2 text-xs text-slate-400">
              <span class="font-semibold text-slate-200">Typical use: </span>
              {sys.typicalUse}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
