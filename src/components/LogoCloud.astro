---
import { site } from '@content/site';
const items = site.logoCloud.items;
---

<section aria-labelledby="clients" class="border-y border-slate-800 bg-slate-900/60">
  <div class="container py-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <p id="clients" class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">
      {site.logoCloud.title}
    </p>
    <div class="flex flex-wrap gap-4 text-xs text-slate-300">
      {items.map((item) => (
        <span class="rounded-full border border-slate-700/80 px-3 py-1">
          {item}
        </span>
      ))}
    </div>
  </div>
</section>
