---
import type { CapabilityId } from '@content/site';
import { site } from '@content/site';

const { capabilityId } = Astro.props as { capabilityId: CapabilityId };
const capability = site.capabilities.find((c) => c.id === capabilityId);
if (!capability) throw new Error(`Capability ${capabilityId} not found`);
---

<article class="flex flex-col gap-3 rounded-2xl border border-slate-800 bg-slate-950/60 p-5 shadow-sm">
  <h3 class="text-base font-semibold text-white">{capability.title}</h3>
  <p class="text-sm text-slate-300">{capability.description}</p>
  <ul class="mt-1 space-y-1 text-sm text-slate-400">
    {capability.bullets.map((b) => (
      <li>• {b}</li>
    ))}
  </ul>
</article>
