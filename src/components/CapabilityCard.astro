---
import type { CapabilityId } from "@content/site";
import { site } from "@content/site";

const { capabilityId } = Astro.props as { capabilityId: CapabilityId };
const capability = site.capabilities.find((c) => c.id === capabilityId);
if (!capability) throw new Error(`Capability ${capabilityId} not found`);
---

<article
  class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-colors duration-300 dark:border-slate-800 dark:bg-slate-950/60"
>
  <h3 class="text-base font-semibold text-slate-800 dark:text-white">
    {capability.title}
  </h3>
  <p class="text-sm text-slate-600 dark:text-slate-300">
    {capability.description}
  </p>
  <ul class="mt-1 space-y-1 text-sm text-slate-500 dark:text-slate-400">
    {capability.bullets.map((b) => <li>• {b}</li>)}
  </ul>
</article>
