---
import { site } from "@content/site";
const { leakSealingSteps, compositeWrapSteps } = site.howItWorks;
---

<section
  id="process"
  class="border-y border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/80 transition-colors duration-300"
>
  <div class="container py-16 grid gap-10 lg:grid-cols-2">
    <div>
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-industrial-orange"
      >
        How It Works
      </p>
      <h2 class="mt-2 text-2xl font-semibold text-slate-800 dark:text-white">
        Engineered on-line leak sealing.
      </h2>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
        Based on the classic Furmanite on-line leak sealing process, Excel Stark
        uses dimension sheets, FEA-verified clamp designs and UK-approved
        calculations to ensure each enclosure is safe before it ever touches
        your line.
      </p>
      <ol class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-300">
        {
          leakSealingSteps.map((step, idx) => (
            <li class="flex gap-3">
              <span class="mt-0.5 inline-flex h-5 w-5 items-center justify-center rounded-full bg-industrial-blue text-[11px] font-semibold">
                {idx + 1}
              </span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div>
      <h3 class="text-lg font-semibold text-slate-800 dark:text-white">
        Composite cold wrapping.
      </h3>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
        Composite cold wrapping is one of the fastest ways to extend remaining
        life or arrest corrosion without hot work — using glass, carbon or
        water-activated wraps selected to your design envelope.
      </p>
      <ol class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-300">
        {
          compositeWrapSteps.map((step, idx) => (
            <li class="flex gap-3">
              <span class="mt-0.5 inline-flex h-5 w-5 items-center justify-center rounded-full bg-industrial-orange text-[11px] font-semibold">
                {idx + 1}
              </span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-xs text-slate-500 dark:text-slate-400">
        Note: Material selection is based on temperature, pressure, fluid
        contents, leak condition and whether the unit is online or offline, as
        outlined in your design parameters.
      </p>
    </div>
  </div>
</section>
