---
import { site } from "@content/site";

const hcaptchaSiteKey = import.meta.env.HCAPTCHA_SITEKEY;
---

<section id="contact" class="bg-slate-950 border-t border-slate-800">
  <div class="container py-16 grid gap-10 lg:grid-cols-[1.2fr_1.5fr]">
    <div>
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-industrial-orange"
      >
        Contact
      </p>
      <h2 class="mt-2 text-2xl font-semibold">{site.contact.headline}</h2>
      <p class="mt-3 text-sm text-slate-300">{site.contact.subcopy}</p>
      <ul class="mt-4 space-y-1 text-sm text-slate-400">
        {site.contact.regions.map((r) => <li>• {r}</li>)}
      </ul>
      <p class="mt-4 text-xs text-slate-500">
        We aim to respond to urgent leaks on the same day. For true emergencies,
        please follow your site escalation protocol alongside this form.
      </p>
    </div>

    <form
      id="contact-form"
      class="space-y-4 rounded-2xl border border-slate-800 bg-slate-900/70 p-6"
      novalidate
    >
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="name" class="text-xs font-semibold text-slate-200"
            >Full name</label
          >
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            required
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white"
          />
        </div>
        <div>
          <label for="email" class="text-xs font-semibold text-slate-200"
            >Work email</label
          >
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white"
          />
        </div>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="company" class="text-xs font-semibold text-slate-200"
            >Company</label
          >
          <input
            id="company"
            name="company"
            type="text"
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white"
          />
        </div>
        <div>
          <label for="region" class="text-xs font-semibold text-slate-200"
            >Region</label
          >
          <select
            id="region"
            name="region"
            required
            class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white"
          >
            <option value="">Select region</option>
            {site.contact.regions.map((r) => <option value={r}>{r}</option>)}
          </select>
        </div>
      </div>

      <div>
        <label for="details" class="text-xs font-semibold text-slate-200">
          Leak / defect details
        </label>
        <textarea
          id="details"
          name="details"
          rows="4"
          required
          class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white"
          placeholder="Line size, design/operating pressure & temperature, service, defect description, any UT/MFL data…"
        ></textarea>
      </div>

      <div>
        <label for="urgency" class="text-xs font-semibold text-slate-200">
          Urgency
        </label>
        <select
          id="urgency"
          name="urgency"
          required
          class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white"
        >
          <option value="">Select</option>
          <option value="emergency_24h"
            >Active leak – 24h support required</option
          >
          <option value="high_3d">High – respond within 3 days</option>
          <option value="medium_7d">Medium – respond within 7 days</option>
        </select>
      </div>

      <div class="space-y-2">
        <div
          class="h-captcha"
          data-sitekey={hcaptchaSiteKey}
          aria-describedby="captcha-help"
        >
        </div>
        <p id="captcha-help" class="text-[11px] text-slate-500">
          This site is protected by hCaptcha. The hCaptcha Privacy Policy and
          Terms of Service apply.
        </p>
      </div>

      <p id="form-error" class="hidden text-xs text-industrial-danger"></p>
      <p id="form-success" class="hidden text-xs text-emerald-400"></p>

      <button
        type="submit"
        class="inline-flex items-center rounded-full bg-industrial-orange px-5 py-2 text-xs font-semibold uppercase tracking-wide text-white"
        data-analytics-event="form_submit"
      >
        Submit leak details
      </button>
    </form>
  </div>

  <script src="https://js.hcaptcha.com/1/api.js" async defer is:inline></script>

  <script>
    const form = document.getElementById("contact-form");
    if (form) {
      const errorEl = document.getElementById("form-error");
      const successEl = document.getElementById("form-success");

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!errorEl || !successEl) return;

        errorEl.classList.add("hidden");
        successEl.classList.add("hidden");

        const formData = new FormData(form as HTMLFormElement);
        const payload = Object.fromEntries(formData.entries());

        // basic client-side validation
        if (
          !payload.name ||
          !payload.email ||
          !payload.details ||
          !payload.region
        ) {
          errorEl.textContent = "Please fill in all required fields.";
          errorEl.classList.remove("hidden");
          return;
        }

        // @ts-ignore
        const captchaToken = window.hcaptcha?.getResponse?.();
        if (!captchaToken) {
          errorEl.textContent = "Please complete the hCaptcha challenge.";
          errorEl.classList.remove("hidden");
          return;
        }

        try {
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ...payload, hcaptchaToken: captchaToken }),
          });

          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.error || "Submission failed");
          }

          successEl.textContent =
            "Thanks. Your leak details were received and an engineer will revert shortly.";
          successEl.classList.remove("hidden");
          (form as HTMLFormElement).reset();
          // @ts-ignore
          window.hcaptcha?.reset?.();
        } catch (err) {
          errorEl.textContent =
            err instanceof Error
              ? err.message
              : "Something went wrong. Please try again.";
          errorEl.classList.remove("hidden");
        }
      });
    }
  </script>
</section>
