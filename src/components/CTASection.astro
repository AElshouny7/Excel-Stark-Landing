---
import { site } from '@content/site';
---

<section class="bg-gradient-to-r from-industrial-blue to-slate-900">
  <div class="container py-12 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2 class="text-xl font-semibold text-white">
        Ready for an engineered leak sealing concept?
      </h2>
      <p class="mt-2 text-sm text-slate-200">
        Share your line data, defect measurements and photos. We will respond with a standards-based
        repair concept and implementation plan.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a
        href="#contact"
        class="inline-flex items-center rounded-full bg-white px-4 py-2 text-xs font-semibold uppercase tracking-wide text-slate-900"
        data-analytics-event="cta_request_support"
      >
        Request Engineering Support
      </a>
      <!-- <a
        href="/excel-stark-product-deck.pdf"
        class="inline-flex items-center rounded-full border border-slate-200/40 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-slate-100"
        data-analytics-event="cta_download_deck"
      >
        Download Product Deck (PDF)
      </a> -->
    </div>
  </div>
</section>
