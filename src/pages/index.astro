---
import Layout from "@components/Layout.astro";
import LogoCloud from "@components/LogoCloud.astro";
import CapabilityCard from "@components/CapabilityCard.astro";
import ProductSystemList from "@components/ProductSystemList.astro";
import CaseStudySnippets from "@components/CaseStudySnippets.astro";
import HowItWorks from "@components/HowItWorks.astro";
import MetricsStrip from "@components/MetricsStrip.astro";
import Differentiators from "@components/Differentiators.astro";
import ServicesProductsToggle from "@components/ServicesProductsToggle.astro";
import FAQAccordion from "@components/FAQAccordion.astro";
import CTASection from "@components/CTASection.astro";
import ContactForm from "@components/ContactForm";
import { site } from "@content/site";

const abVariant = Astro.locals.abVariant ?? "heroA";
const hero = site.hero[abVariant];
---

<Layout path="/">
  <section
    class="relative bg-gradient-to-b from-slate-950 via-slate-950 to-slate-900 overflow-hidden"
  >
    <picture
      class="absolute inset-0 h-full w-full pointer-events-none select-none opacity-25"
    >
      <source srcset="/hero-repair-inspection.avif" type="image/avif" />
      <source srcset="/hero-repair-inspection.webp" type="image/webp" />
      <img
        src="/hero-repair-inspection.png"
        width="1600"
        height="900"
        alt="Engineer measuring composite wrap repair on a coated pipeline using a tape measure and dial gauge during inspection."
        class="h-full w-full object-cover"
        loading="eager"
        decoding="async"
      />
    </picture>
    <div
      class="relative container py-16 lg:py-24 grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] items-center"
    >
      <div class="space-y-6">
        <p
          class="text-xs font-semibold uppercase tracking-[0.25em] text-industrial-orange"
        >
          {hero.eyebrow}
        </p>
        <h1 class="text-3xl md:text-4xl font-semibold text-white">
          {hero.title}
        </h1>
        <p class="max-w-xl text-sm md:text-base text-slate-300">
          {hero.subtitle}
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={hero.primaryCta.href}
            class="inline-flex items-center rounded-full bg-industrial-orange px-5 py-2 text-xs font-semibold uppercase tracking-wide text-white shadow-card"
            data-analytics-event={hero.primaryCta.analyticsId}
          >
            {hero.primaryCta.label}
          </a>
          <!-- <a
            href={hero.secondaryCta.href}
            class="inline-flex items-center rounded-full border border-slate-500 px-5 py-2 text-xs font-semibold uppercase tracking-wide text-slate-100"
            data-analytics-event={hero.secondaryCta.analyticsId}
          >
            {hero.secondaryCta.label}
          </a> -->
        </div>

        <ul class="mt-4 space-y-1 text-xs text-slate-400">
          {site.values.map((v) => <li>• {v}</li>)}
        </ul>
      </div>

      <div
        class="rounded-3xl border border-slate-800 bg-slate-950/70 p-5 text-xs text-slate-300"
      >
        <p class="font-mono text-[11px] text-slate-400 mb-2">
          Online Leak Sealing Design Flow (excerpt)
        </p>
        <ol class="space-y-1">
          <li>1 ▸ On-site dimension sheet for pipe, flange or valve.</li>
          <li>2 ▸ Engineering design & FEA bolt-stress analysis.</li>
          <li>3 ▸ UK approval of calculation sheets & drawings.</li>
          <li>4 ▸ Clamp / enclosure fabrication & inspection.</li>
          <li>5 ▸ Installation on-line and compound injection.</li>
          <li>6 ▸ Leak verification and documentation.</li>
        </ol>
        <p class="mt-3 text-[11px] text-slate-500">
          Based on classic Furmanite leak sealing methodology, adapted and
          extended for Excel Stark’s composite systems.
        </p>
      </div>
    </div>
  </section>

  <LogoCloud />
  <MetricsStrip />

  <section id="capabilities" class="relative bg-slate-950 overflow-hidden">
    <picture
      class="absolute inset-0 h-full w-full opacity-20 pointer-events-none select-none"
    >
      <source srcset="/hero-offshore-repair.avif" type="image/avif" />
      <source srcset="/hero-offshore-repair.webp" type="image/webp" />
      <img
        src="/hero-offshore-repair.png"
        width="1600"
        height="900"
        alt="Composite leak sealing and repair systems background texture"
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="relative container py-16 space-y-8">
      <header class="max-w-2xl">
        <p
          class="text-xs font-semibold uppercase tracking-[0.2em] text-industrial-orange"
        >
          Core Capabilities
        </p>
        <h2 class="mt-2 text-2xl font-semibold">
          Online leak sealing and composite repair, engineered to global
          standards.
        </h2>
        <p class="mt-3 text-sm text-slate-300">
          From enclosures for live leaks to crack-resistant high modulus carbon
          systems, Excel Stark covers the full spectrum of clamp, wrap and
          hybrid repair solutions.
        </p>
      </header>

      <div class="grid gap-4 md:grid-cols-3">
        {site.capabilities.map((c) => <CapabilityCard capabilityId={c.id} />)}
      </div>
    </div>
  </section>

  <ProductSystemList />
  <HowItWorks />
  <CaseStudySnippets />
  <ServicesProductsToggle />
  <Differentiators />
  <FAQAccordion />
  <CTASection />
  <ContactForm client:idle siteKey={import.meta.env.HCAPTCHA_SITEKEY} />
</Layout>
